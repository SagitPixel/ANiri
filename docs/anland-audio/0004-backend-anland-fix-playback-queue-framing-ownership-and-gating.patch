     }
     struct msghdr m = { .msg_iov = iov, .msg_iovlen = n_iov };
@@ -361,26 +404,27 @@ static int sender_send_one(struct anland_audio *a, int fd)
     ssize_t n = sendmsg(fd, &m, MSG_DONTWAIT | MSG_NOSIGNAL);
     if (n < 0) {
